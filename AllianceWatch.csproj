<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AllianceWatch.ico</ApplicationIcon>
    <AssemblyName>AllianceWatch</AssemblyName>
    <RootNamespace>AllianceWatch</RootNamespace>
    <Authors>Jesse Lee Shelley</Authors>
    <Copyright>Copyright (c) 2026 Jesse Lee Shelley. All Rights Reserved.</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/ultros/alliance-watch</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\AllianceWatch.ico" />
    <EmbeddedResource Include="Assets\AllianceWatch.png" />
    <EmbeddedResource Include="config.json" LogicalName="AllianceWatch.DefaultConfig.json" />
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\ne_110m_land.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="LICENSE;NOTICE;CITATION.cff;THIRD-PARTY-NOTICES.md;Licenses\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
